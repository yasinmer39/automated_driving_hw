      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [x_dot, y_dot, theta_dot]  = fcn(steering_angle, L, v, theta)

x_dot     = v*cos(theta);
y_dot     = v*sin(theta);
theta_dot = v*tan(steering_angle)/L;


</P>
      </eml>
    </state>
